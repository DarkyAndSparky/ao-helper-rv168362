<?xml version="1.0" encoding="ISO-8859-1"?>
<project name="obfushelpers" default="all">
  
  
  <property file="obfushelpers.properties"/>
  <!-- Uncomment the following property if no tests compilation is needed -->
  <!-- 
  <property name="skip.tests" value="true"/>
   -->
  
  <!-- Compiler options -->
  
  <property name="compiler.debug" value="on"/>
  <property name="compiler.generate.no.warnings" value="off"/>
  <property name="compiler.args" value=""/>
  <property name="compiler.max.memory" value="128m"/>
  <patternset id="ignored.files">
    <exclude name="**/CVS/**"/>
    <exclude name="**/SCCS/**"/>
    <exclude name="**/RCS/**"/>
    <exclude name="**/rcs/**"/>
    <exclude name="**/.DS_Store/**"/>
    <exclude name="**/.svn/**"/>
    <exclude name="**/.sbas/**"/>
    <exclude name="**/.IJI.*/**"/>
    <exclude name="**/vssver.scc/**"/>
    <exclude name="**/vssver2.scc/**"/>
  </patternset>
  <patternset id="compiler.resources">
    <include name="**/?*.properties"/>
    <include name="**/?*.xml"/>
    <include name="**/?*.gif"/>
    <include name="**/?*.png"/>
    <include name="**/?*.jpeg"/>
    <include name="**/?*.jpg"/>
    <include name="**/?*.html"/>
    <include name="**/?*.dtd"/>
    <include name="**/?*.tld"/>
  </patternset>
  
  <!-- JDK definitions -->
  
  <property name="jdk.bin.a1" value="${jdk.home.a1}/bin"/>
  <path id="jdk.classpath.a1">
    <fileset dir="${jdk.home.a1}">
      <include name="jre/lib/charsets.jar"/>
      <include name="jre/lib/deploy.jar"/>
      <include name="jre/lib/javaws.jar"/>
      <include name="jre/lib/jce.jar"/>
      <include name="jre/lib/jsse.jar"/>
      <include name="jre/lib/management-agent.jar"/>
      <include name="jre/lib/plugin.jar"/>
      <include name="jre/lib/resources.jar"/>
      <include name="jre/lib/rt.jar"/>
      <include name="jre/lib/ext/dnsns.jar"/>
      <include name="jre/lib/ext/localedata.jar"/>
      <include name="jre/lib/ext/sunjce_provider.jar"/>
      <include name="jre/lib/ext/sunmscapi.jar"/>
      <include name="jre/lib/ext/sunpkcs11.jar"/>
    </fileset>
  </path>
  
  <property name="project.jdk.home" value="${jdk.home.a1}"/>
  <property name="project.jdk.bin" value="${jdk.bin.a1}"/>
  <property name="project.jdk.classpath" value="jdk.classpath.a1"/>
  
  
  <!-- Project Libraries -->
  
  <path id="library.zkm.classpath">
    <pathelement location="${basedir}/lib/vendor/ZKM.jar"/>
  </path>
  
  <path id="library.jetbrainsannotations.classpath">
    <pathelement location="${basedir}/lib/vendor/jetbrainsAnnotations.jar"/>
  </path>
  
  <path id="library.args4j.classpath">
    <pathelement location="${basedir}/lib/vendor/args4j-2.0.9.jar"/>
  </path>
  
  
  <!-- Global Libraries -->
  
  <path id="library.groovy-1.6.5.classpath">
    <pathelement location="${basedir}/lib/vendor/groovy-all-1.6.5.jar"/>
  </path>
  
  <taskdef name="groovyc"
         classname="org.codehaus.groovy.ant.Groovyc"
         classpathref="library.groovy-1.6.5.classpath" />

  <!-- Modules -->
  
  <import file="${basedir}/module_obfushelpers.xml"/>
  
  <target name="init" description="Build initialization">
    <!-- Perform any build initialization in this target -->
  </target>
  
  <target name="clean" depends="clean.module.obfushelpers" description="cleanup all"/>
  
  <target name="all" depends="init, clean, compile.module.obfushelpers" description="build all">
	<copy verbose="false" overwrite="true" preservelastmodified="true" failonerror="false"
          todir="${base.dir}/../jars">
      <fileset dir="out/production/obfusHelpers">
        <exclude name="obfusHelpers/"/>
      </fileset>
    </copy>
	<exec executable="svn" failonerror="true">
      <arg value="commit"/>
      <arg value="--non-interactive"/>
      <arg value="--config-dir"/>
      <arg value="/root/.subversion"/>
      <arg path="${base.dir}/../jars"/>
	  <arg value="-m"/>
	  <arg value="internal: auto-commit of obuscation tools"/>
    </exec>
  </target>
</project>